                    {
                      "name": "Upload Package Dependencies via Lock File",
                      "id": "acfac414-8bda-4e1a-af90-9b2d4c9bbd8e",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
