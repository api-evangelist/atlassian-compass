          "name": "Send an event into an event source",
          "request": {
            "name": "Send an event into an event source",
            "description": {
              "content": "Sends an event into a Compass event source. Returns 202 Accepted\nand processes the event asynchronously. Rate limited to 100 requests\nper user per minute.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "compass",
                "v1",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "write:metric:compass write:event:compass read:component:compass write:component:compass"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.atlassian.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://auth.atlassian.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventSourceId\": \"<string>\",\n  \"payload\": \"<object>\",\n  \"externalEventId\": \"<string>\",\n  \"displayName\": \"<string>\",\n  \"description\": \"<string>\",\n  \"url\": \"<uri>\",\n  \"lastUpdated\": \"<dateTime>\"\n}",
